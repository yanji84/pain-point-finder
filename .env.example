# GapScout Server Configuration
# Copy this file to .env and fill in your values.

# Server port (default: 3000)
PORT=3000

# Directory for scan data, SQLite DB, and ideas (default: ./data)
DATA_DIR=./data

# Optional URL prefix if running behind a reverse proxy (e.g., /gapscout)
BASE_PATH=

# Session secret — generate a random string for production
# If omitted, a random secret is generated on each restart (sessions won't persist across restarts)
SESSION_SECRET=

# Max concurrent scans running at once (default: 3)
MAX_CONCURRENT_SCANS=3

# Set to "production" to disable dev-mode webhook bypass
NODE_ENV=development
